# 复制为 .env 并填写真实值。.env 已被 gitignore，绝不提交。

# 应用
APP_NAME=music-agent
APP_ENV=development
DEBUG=true
SECRET_KEY=change-me
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_MINUTES=4320
REFRESH_COOKIE_NAME=refresh_token
REFRESH_COOKIE_SECURE=false
REFRESH_COOKIE_SAMESITE=lax

# 数据库（PostgreSQL + pgvector：业务数据和向量一个库）
DATABASE_URL=postgresql+psycopg://postgres:your_password@127.0.0.1:5432/music_agent

# DeepSeek（大模型）
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# Jamendo（音乐数据源，去 developer.jamendo.com 免费申请）
JAMENDO_CLIENT_ID=
JAMENDO_BASE_URL=https://api.jamendo.com/v3.0
