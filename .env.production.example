# 复制为 .env.production，仅放服务器，不要提交到 Git。

# PostgreSQL（建议使用 openssl rand -hex 24 生成 URI 安全密码）
POSTGRES_USER=music_agent
POSTGRES_PASSWORD=replace-with-a-long-random-password
POSTGRES_DB=music_agent
DATABASE_URL=postgresql+psycopg://music_agent:replace-with-a-long-random-password@db:5432/music_agent

# 应用安全
SECRET_KEY=replace-with-a-random-secret
APP_ENV=production
DEBUG=false
REFRESH_COOKIE_SECURE=true
CORS_ORIGINS=["https://your-domain.example"]

# DeepSeek API
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash

# Embedding（可选；未配置时使用文本检索兜底）
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=
EMBEDDING_MODEL=

# Jamendo（暂不导入时可留空）
JAMENDO_CLIENT_ID=
JAMENDO_BASE_URL=https://api.jamendo.com/v3.0
JAMENDO_TIMEOUT_SECONDS=30
JAMENDO_MAX_RETRIES=3
JAMENDO_RETRY_BASE_SECONDS=1
