# 复制为 .env 并填写真实值。.env 已被 gitignore，绝不提交。

# 应用
APP_NAME=music-agent
APP_ENV=development
DEBUG=true
# 至少 32 字节随机值，禁止使用 change-me
SECRET_KEY=replace-with-a-random-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_MINUTES=4320
REFRESH_COOKIE_NAME=refresh_token
REFRESH_COOKIE_SECURE=false
REFRESH_COOKIE_SAMESITE=lax
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
# 演示账号用户名（只读保护）：该账号可读全部数据，但所有写操作返回 403。
# 大小写不敏感；留空表示不启用演示账号保护。
DEMO_USERNAME=demo

# 数据库（PostgreSQL + pgvector：业务数据和向量一个库）
DATABASE_URL=postgresql+psycopg://postgres:your_password@127.0.0.1:5432/music_agent

# DeepSeek（大模型）
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_TIMEOUT_SECONDS=30

# Agent 上下文与工具预算
AGENT_CONTEXT_TOKEN_BUDGET=12000
AGENT_RESPONSE_TOKEN_BUDGET=2000
AGENT_TOOL_RESULT_MAX_CHARS=12000
AGENT_TOOL_TIMEOUT_SECONDS=10

# Agent 循环防护：轮数保险丝 / 时间预算 / 无进展检测（见 docs/agent-fallback.md）
AGENT_MAX_TOOL_ROUNDS=20
AGENT_TOTAL_TIMEOUT_SECONDS=90
AGENT_NO_PROGRESS_LIMIT=2

# Agent 工具失败重试（仅对只读工具生效）与写操作确认有效期
AGENT_TOOL_RETRY_MAX=2
AGENT_TOOL_RETRY_BACKOFF_SECONDS=0.5
AGENT_CONFIRMATION_TTL_SECONDS=600

# 联网搜索（Agent 的 search_web 工具）
# WEB_SEARCH_PROVIDER 取 tavily（官方 API，返回已抽取正文，需 key）
# / bing_cn（抓取必应中国，境内可达）/ duckduckgo（境外，境内不可达）
WEB_SEARCH_ENABLED=true
WEB_SEARCH_PROVIDER=bing_cn
WEB_SEARCH_BING_URL=https://cn.bing.com/search
WEB_SEARCH_MARKET=zh-CN
WEB_SEARCH_REGION=cn-zh
WEB_SEARCH_MAX_RESULTS=5
WEB_SEARCH_TIMEOUT_SECONDS=8
# 用 tavily 时填下面三项；key 只能放环境变量，禁止写进源码或提交到 Git
WEB_SEARCH_API_KEY=
WEB_SEARCH_TAVILY_URL=https://api.tavily.com/search
WEB_SEARCH_TAVILY_DEPTH=basic

# Embedding（可选，需使用 OpenAI-compatible /embeddings 服务）
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=
EMBEDDING_MODEL=
EMBEDDING_TIMEOUT_SECONDS=30
# 歌曲相似度阈值：口径较松（结构化兜底会再筛）
EMBEDDING_SIMILARITY_THRESHOLD=0.35
# 知识库检索阈值：必须比歌曲那条严
EMBEDDING_KNOWLEDGE_THRESHOLD=0.50
# 向量维度必须与 EMBEDDING_MODEL 一致（BAAI/bge-m3 = 1024），改动需新写迁移
EMBEDDING_DIMENSION=1024

# Jamendo（当前导入管道未使用，保留占位；可留空）
JAMENDO_CLIENT_ID=
JAMENDO_BASE_URL=https://api.jamendo.com/v3.0
JAMENDO_TIMEOUT_SECONDS=30
JAMENDO_MAX_RETRIES=3
JAMENDO_RETRY_BASE_SECONDS=1
